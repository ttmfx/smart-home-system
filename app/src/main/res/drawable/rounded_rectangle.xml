<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color of the rectangle -->
    <solid android:color="#2A2A2A"/> <!-- White background color, change as needed -->

    <!-- Corner radius for rounded corners -->
    <corners android:radius="8dp"/> <!-- Adjust the corner radius as needed -->

    <!-- Border (stroke) around the rectangle -->
    <stroke
        android:color="#61FFFFFF"
        android:width="1dp"></stroke> <!-- Border color, change if needed -->
    <!-- Border width, you can increase this for a thicker border -->
</shape>